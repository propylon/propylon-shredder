# Deploy
DEBUG=1
ENV_TYPE=local
SERVICE_NAME=shredder_app

# Build
PYTHON_VERSION=3.13
PYTHONPATH=./shredder/src
ENV_DIR=.venv
UV_PROJECT_ENVIRONMENT=${ENV_DIR}

# Docker
DOCKER_COMPOSE_PROJECT=shredder
COMPOSE_ENV_FILES=.env
DOCKER_NETWORK_NAME=backend

# Procrastinate
PROCRASTINATE_APP=shredder.app
PROCRASTINATE_WORKER=shredder_worker
PROCRASTINATE_TASK_PATHS=shredder.tasks
PROCRASTINATE_QUEUE=shredder_queue
# Specify how many jobs are handled at once by the Procrastinate worker
# (depends on max threads and also how much downtime is expected in the job flow: I/O, network latency, etc.)
PROCRASTINATE_CONCURRENCY=4
# Postgres DB Connection
PROCRASTINATE_DB_HOST=127.0.0.1
PROCRASTINATE_DB_PORT=5432
PROCRASTINATE_DB_USER=db_admin
PROCRASTINATE_DB_PASSWORD=db_password
PROCRASTINATE_DB_NAME=shredder_procrastinate_db

# S3 Storage Configuration (optional)
# STORAGE_ACCESS_ID=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET_NAME=
# STORAGE_ENDPOINT_URL=
# STORAGE_ADDRESSING_STYLE=
# STORAGE_DEFAULT_ACL=
